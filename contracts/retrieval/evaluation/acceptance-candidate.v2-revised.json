  "sources": [
    {
      "alias": "N00",
      "kind": "NODE",
      "text": "Workspace Unit具有稳定UUID身份；节点软删除仅撤回可见性而保留历史溯源。检索sourceVersion为派生来源的版本标识，不意味着每个Node实体具有version字段。 验收夹具标识 FACT-3100。",
      "provenance": {
        "repositoryPath": "docs/v2/NODE_MODEL_V2.md",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Node entity has no version column; retrieval sourceVersion is derived source identifier."
      }
    },
    {
      "alias": "N01",
      "kind": "NODE",
      "text": "Java Runtime根据冻结事件与输入确定动作能否提议，并重验准入；AdvisorPolicy独立决定自动执行、确认或拒绝。WAIT只允许已存在且获准的pending依赖，Graph lineage不得合并或rejoin。 验收夹具标识 FACT-3101。",
      "provenance": {
        "repositoryPath": "docs/v2/AGENT_RUNTIME.md",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Graph lineage merging/rejoining is strictly forbidden; Action Eligibility only gates proposals."
      }
    },
    {
      "alias": "N02",
      "kind": "NODE",
      "text": "当前固定检索配置中vector候选lane使用最大余弦距离0.50；lexical/trigram通道不受此距离统一截断。 验收夹具标识 FACT-3102。",
      "provenance": {
        "repositoryPath": "docs/v2/UNIFIED_PYTHON_RAG_DESIGN.md",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: 0.50 applies specifically to vector lane, lexical/trigram lane is not truncated by this distance."
      }
    },
    {
      "alias": "N03",
      "kind": "NODE",
      "text": "索引重建Worker通过RebuildLeaseCoordinator认领embedding_rebuilds并以epoch/lease/worker围栏写入；过期行可被接管或按attempt策略重排/失败，区别于全局Agent任务调度。 验收夹具标识 FACT-3103。",
      "provenance": {
        "repositoryPath": "backend/src/main/java/com/specagent/retrieval/workload/RebuildLeaseCoordinator.java",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: RebuildLeaseCoordinator coordinates embedding_rebuilds tasks, not global multi-worker scheduling."
      }
    },
    {
      "alias": "N04",
      "kind": "NODE",
      "text": "运行时模型网关对所有供应商响应实施 Fail-Closed 校验；格式不合规的结构化输出直接标记为失败。 验收夹具标识 FACT-3104。",
      "provenance": {
        "repositoryPath": "docs/v2/AGENT_RUNTIME_ARCHITECTURE.md",
        "sourceVersion": "1"
      }
    },
    {
      "alias": "N05",
      "kind": "NODE",
      "text": "跨项目检索授权通过 RetrievalScopeGrant 显式下发；无当前项目授权的私有语料在 SQL 层直接阻断。 验收夹具标识 FACT-3105。",
      "provenance": {
        "repositoryPath": "docs/v2/PHASE2_IDENTITY_AUTHORIZATION_DESIGN.md",
        "sourceVersion": "1"
      }
    },
    {
      "alias": "N06",
      "kind": "NODE",
      "text": "全局助手在 LangChain 架构下将会话记忆与持久化 Checkpoint 绑定；单步失败不会破坏历史有效状态。 验收夹具标识 FACT-3106。",
      "provenance": {
        "repositoryPath": "docs/v2/GLOBAL_ASSISTANT_LANGCHAIN_REDESIGN.md",
        "sourceVersion": "1"
      }
    },
    {
      "alias": "N07",
      "kind": "NODE",
      "text": "词法通道使用CJK双字bigram增强无中文分词器时的召回；无共享bigram仍可能漏召回，共享常见双字也可能误召回。 验收夹具标识 FACT-3107。",
      "provenance": {
        "repositoryPath": "backend/src/main/resources/db/migration/V94__cjk_aware_lexical_lane.sql",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: CJK bigram enhances lexical recall without segmenter; does not guarantee 100% natural language recall."
      }
    },
    {
      "alias": "N08",
      "kind": "NODE",
      "text": "固定项目profile使用qwen3-embedding:0.6b和1024维向量；归一化后按float32存储，以小端float32字节计算SHA-256检查数据一致性，checksum不认证模型或内容真实性。 验收夹具标识 FACT-3108。",
      "provenance": {
        "repositoryPath": "docs/v2/UNIFIED_PYTHON_RAG_DESIGN.md",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Little-endian float32 checksum validates data transmission integrity, not authenticity of model."
      }
    },
    {
      "alias": "N09",
      "kind": "NODE",
      "text": "C16-WAIT由超时定时器或事件通知唤醒并重新评估条件；超时唤醒不等于任务取消。 验收夹具标识 FACT-3109。",
      "provenance": {
        "repositoryPath": "backend/src/main/java/com/specagent/agent/action/ActionEligibility.java",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Timeout timer wakes up and re-evaluates condition or degrades; timeout does not equal cancellation."
      }
    },
    {
      "alias": "N10",
      "kind": "NODE",
      "text": "混合检索融合采用标准 Reciprocal Rank Fusion (RRF)，平滑常数 k 固定配置为 60。 验收夹具标识 FACT-3110。",
      "provenance": {
        "repositoryPath": "docs/v2/UNIFIED_PYTHON_RAG_DESIGN.md",
        "sourceVersion": "1"
      }
    },
    {
      "alias": "N11",
      "kind": "NODE",
      "text": "Answer历史修改通过AnswerPatch追加记录，不覆写原Answer；通用Node属性不使用AnswerPatch修改。 验收夹具标识 FACT-3111。",
      "provenance": {
        "repositoryPath": "docs/CONTEXT_RULES.md",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: AnswerPatch is dedicated to Answer recovery checkpoints, not general Node property mutation."
      }
    },
    {
      "alias": "N12",
      "kind": "NODE",
      "text": "外部 Web 检索工具 Tavily 仅在全局助手明确授权时调用；获取的网页内容按外部证据级别标记。 验收夹具标识 FACT-3112。",
      "provenance": {
        "repositoryPath": "docs/v2/GLOBAL_ASSISTANT_SINGLE_ENGINE_AND_WEB_TOOLS_PLAN.md",
        "sourceVersion": "1"
      }
    },
    {
      "alias": "N13",
      "kind": "NODE",
      "text": "项目 Agent 对当前路线的上下文重构采用线性祖先溯源；被剪枝或分叉的同级路线节点排除在上下文窗口之外。 验收夹具标识 FACT-3113。",
      "provenance": {
        "repositoryPath": "docs/v2/GRAPH_ROUTE_CONTEXT_INTEGRITY_INVESTIGATION.md",
        "sourceVersion": "1"
      }
    },
    {
      "alias": "N14",
      "kind": "NODE",
      "text": "内部HTTP客户端配置请求与连接超时预算；超时未响应抛出超时异常，系统未引入独立circuit breaker熔断器。 验收夹具标识 FACT-3114。",
      "provenance": {
        "repositoryPath": "backend/src/main/java/com/specagent/model/provider/HttpOpenCodeZenTransport.java",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Timeout budgets raise HTTP timeout exceptions; no standalone circuit breaker component exists."
      }
    },
    {
      "alias": "N15",
      "kind": "NODE",
      "text": "内部服务客户端显式采用DIRECT直连以防代理劫持；全局SOCKS代理环境变量保持保留，不静默删除用户环境配置。 验收夹具标识 FACT-3115。",
      "provenance": {
        "repositoryPath": "agent-brain/requirements.lock",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Internal clients explicitly use DIRECT connection while preserving global proxy environment."
      }
    },
    {
      "alias": "R00",
      "kind": "RESOURCE",
      "text": "# 分块规范文档\n\n文本切分采用固定长度窗口；单块最大长度受配置控制，实现中不使用100字符滑动重叠。文档归档编号 DOC-CHUNK-800。",
      "provenance": {
        "repositoryPath": "agent-brain/src/spec_agent_brain/retrieval/chunks.py",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Real chunking implementation does not use 100-char sliding overlap."
      }
    },
    {
      "alias": "R01",
      "kind": "RESOURCE",
      "text": "# 存储认证规范\n\nPython与Java节点通信使用内部共享Secret Token进行请求头校验，防止未授权跨进程调用；鉴权为单向请求认证而非双向握手。文档归档编号 DOC-AUTH-SHARED。",
      "provenance": {
        "repositoryPath": "backend/src/main/java/com/specagent/retrieval/protocol/RetrievalWire.java",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: Auth is unidirectional X-Spec-Agent-Internal-Token header verification, not bidirectional handshake."
      }
    },
    {
      "alias": "R02",
      "kind": "RESOURCE",
      "text": "# 索引迁移规范\n\n当底层向量索引发生结构升级时，保留旧版本索引直至新 generation 整体校验通过后再行原子切换。文档归档编号 MIG-803。\n",
      "provenance": {
        "repositoryPath": "docs/v2/LOCAL_DEPLOYMENT_SERVICE_CONFIGURATION_GUIDE.md",
        "sourceVersion": "1"
      }
    },
    {
      "alias": "R03",
      "kind": "RESOURCE",
      "text": "# 性能基准规范\n\n本地CPU环境下的检索性能观察目标为P50参考值500毫秒；该值属于观察指标而非强制SLO或单次超时告警门槛。文档归档编号 DOC-PERF-P50。",
      "provenance": {
        "repositoryPath": "docs/acceptance-evidence/rag-d3-sol-independent-review/independent-review.md",
        "sourceVersion": "revised-v2.1",
        "revisionNote": "Corrected: P50 500ms is an observation reference target, not an enforced SLO or timeout alert trigger."
      }
    },
