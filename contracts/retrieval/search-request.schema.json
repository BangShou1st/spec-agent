{
  "$defs": {
    "Grant": {
      "additionalProperties": false,
      "properties": {
        "grantId": {
          "format": "uuid",
          "title": "Grantid",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "expiresAt": {
          "format": "date-time",
          "title": "Expiresat",
          "type": "string"
        }
      },
      "required": [
        "grantId",
        "version",
        "expiresAt"
      ],
      "title": "Grant",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "maxItems": {
          "maximum": 12,
          "minimum": 1,
          "title": "Maxitems",
          "type": "integer"
        },
        "maxChars": {
          "maximum": 12000,
          "minimum": 1,
          "title": "Maxchars",
          "type": "integer"
        },
        "laneLimit": {
          "default": 48,
          "maximum": 48,
          "minimum": 1,
          "title": "Lanelimit",
          "type": "integer"
        }
      },
      "required": [
        "maxItems",
        "maxChars"
      ],
      "title": "Limits",
      "type": "object"
    },
    "Workload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PROJECT_RUN",
            "GA_RUN",
            "CONTEXT_PROJECTION",
            "INDEX_JOB"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "executionEpoch": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Executionepoch",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "executionEpoch"
      ],
      "title": "Workload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "retrieval.v1",
      "title": "Protocolversion",
      "type": "string"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "workload": {
      "$ref": "#/$defs/Workload"
    },
    "scopeGrant": {
      "$ref": "#/$defs/Grant"
    },
    "profileId": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profileid",
      "type": "string"
    },
    "indexGeneration": {
      "format": "uuid",
      "title": "Indexgeneration",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "retrievalEngineVersion": {
      "const": "python-rag.v1",
      "title": "Retrievalengineversion",
      "type": "string"
    },
    "query": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "mode": {
      "enum": [
        "HYBRID",
        "SEMANTIC_ONLY"
      ],
      "title": "Mode",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "workload",
    "scopeGrant",
    "profileId",
    "indexGeneration",
    "deadline",
    "retrievalEngineVersion",
    "query",
    "mode",
    "limits"
  ],
  "title": "SearchRequest",
  "type": "object"
}
