{
  "name": "spec-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vendor:ocr": "node tools/vendor-ocr-assets.mjs",
    "predev": "npm run vendor:ocr",
    "dev": "vite",
    "prebuild": "npm run vendor:ocr",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@vue-flow/core": "1.48.2",
    "dompurify": "^3.4.15",
    "jszip": "^3.10.2",
    "marked": "^18.0.12",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.1",
    "tesseract.js": "^5.1.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.10"
  }
}
